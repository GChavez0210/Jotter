{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/build-cli-sidecar.mjs"
  },
  "bundle": {
    "externalBin": ["binaries/jotter"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/cli-path.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/cli-path.wxs"],
        "componentRefs": ["JotterCliPath"]
      }
    }
  }
}
