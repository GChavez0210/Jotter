{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jotter",
  "version": "0.5.2",
  "identifier": "com.jotter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jotter",
        "width": 1120,
        "height": 760,
        "minWidth": 480,
        "minHeight": 460,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MzVCMTJDQjRBQ0U4QzUKUldURjZLeTBMTEUxSlNsc1YyZDdsR0NkcitZVVhCYVdKWFV6eFFzbWNZWWMvS2trZzJvMzltelcK",
      "endpoints": [
        "https://github.com/GChavez0210/Jotter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../node_modules/dictionary-en/index.aff": "dictionaries/en-US/index.aff",
      "../node_modules/dictionary-en/index.dic": "dictionaries/en-US/index.dic",
      "../node_modules/dictionary-en/license": "dictionaries/en-US/LICENSE",
      "../node_modules/dictionary-en-gb/index.aff": "dictionaries/en-GB/index.aff",
      "../node_modules/dictionary-en-gb/index.dic": "dictionaries/en-GB/index.dic",
      "../node_modules/dictionary-en-gb/license": "dictionaries/en-GB/LICENSE",
      "../node_modules/dictionary-es/index.aff": "dictionaries/es/index.aff",
      "../node_modules/dictionary-es/index.dic": "dictionaries/es/index.dic",
      "../node_modules/dictionary-es/license": "dictionaries/es/LICENSE",
      "../node_modules/dictionary-fr/index.aff": "dictionaries/fr/index.aff",
      "../node_modules/dictionary-fr/index.dic": "dictionaries/fr/index.dic",
      "../node_modules/dictionary-fr/license": "dictionaries/fr/LICENSE",
      "../node_modules/dictionary-de/index.aff": "dictionaries/de/index.aff",
      "../node_modules/dictionary-de/index.dic": "dictionaries/de/index.dic",
      "../node_modules/dictionary-de/license": "dictionaries/de/LICENSE",
      "../node_modules/dictionary-pt/index.aff": "dictionaries/pt-BR/index.aff",
      "../node_modules/dictionary-pt/index.dic": "dictionaries/pt-BR/index.dic",
      "../node_modules/dictionary-pt/license": "dictionaries/pt-BR/LICENSE",
      "../node_modules/dictionary-it/index.aff": "dictionaries/it/index.aff",
      "../node_modules/dictionary-it/index.dic": "dictionaries/it/index.dic",
      "../node_modules/dictionary-it/license": "dictionaries/it/LICENSE"
    },
    "publisher": "Jotter",
    "shortDescription": "Desktop Markdown notes compatible with Obsidian vaults",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
