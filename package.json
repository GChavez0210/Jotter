{
  "name": "jotter",
  "private": true,
  "version": "0.5.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --emit-ts-declarations --silent",
    "check": "npm run i18n && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "tauri": "tauri",
    "test": "npm run i18n && node scripts/test-frontend.mjs",
    "test:review-ui": "npm run i18n && node --test tests/review-ui.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.1.1",
    "katex": "^0.19.0",
    "pele": "^1.6.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "axe-core": "^4.14.0",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.16.0",
    "svelte-check": "^4.7.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
